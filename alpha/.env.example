# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-super-secret-key-here-change-in-production
CLIENT_URL=http://localhost:3000
PROD_CLIENT_URL=https://yourdomain.com
APP_NAME="Financial Gamification App"
COOKIE_DOMAIN=localhost
RP_ID=localhost

# Database - PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/financial_gamification_app

# Social Auth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Social Auth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Social Auth - Discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Email Service - Mailtrap
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=your-mailtrap-username
MAILTRAP_PASSWORD=your-mailtrap-password
FROM_EMAIL="noreply@yourdomain.com"

# SMS Provider - Twilio (optional)
TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Captcha - Google reCAPTCHA
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Stripe Payment Processing
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_AUTH_URL=http://localhost:3000

# Feature Flags
ENABLE_2FA=true
ENABLE_PHONE_VERIFICATION=true
ENABLE_EMAIL_OTP=true
ENABLE_CAPTCHA=true
ENABLE_DEVICE_DETECTION=true
ENABLE_HIBP=true
ENABLE_STRIPE=true

# Development
NODE_ENV=development